{
  "expo": {
    "name": "E&T Auctions",
    "slug": "etelectronics-724",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.etelectronics.auctions",
          "enableGooglePay": true
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "E&T Auctions uses your camera to broadcast live auctions.",
        "NSMicrophoneUsageDescription": "E&T Auctions uses your microphone during live auctions."
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.etelectronics.auctions",
      "permissions": ["CAMERA", "RECORD_AUDIO"]
    },
    "extra": {
      "eas": {
        "projectId": "6f254a9f-d1df-439f-9f64-3d46a9f1ce73"
      }
    }
  }
}
